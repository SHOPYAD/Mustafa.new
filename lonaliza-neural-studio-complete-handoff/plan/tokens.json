{
  "theme": "lonaliza-cybernetic-atlas",
  "resolution": {
    "width": 1672,
    "height": 941,
    "dpr": 1,
    "direction": "rtl",
    "fontFamily": "var(--font-cairo), 'Segoe UI', Tahoma, Arial, sans-serif"
  },
  "colors": {
    "background": "#020c17",
    "backgroundDeep": "#01080f",
    "panel": "#061826f0",
    "panelHeader": "#0b2b3cc0",
    "panelBorder": "#20546a",
    "panelBorderActive": "#27dff4",
    "cyan": "#27dff4",
    "cyanGlow": "rgba(39, 223, 244, 0.4)",
    "gold": "#eec66d",
    "goldGlow": "rgba(238, 198, 109, 0.4)",
    "amber": "#ffb54c",
    "emerald": "#10b981",
    "purple": "#c084fc",
    "redAlert": "#ef4444",
    "mutedText": "#8facbc",
    "primaryText": "#e9f6ff",
    "gridLine": "rgba(14, 76, 87, 0.15)"
  },
  "typography": {
    "headerTitle": { "size": "19px", "weight": "700", "lineHeight": "1.2" },
    "panelTitle": { "size": "13px", "weight": "600", "lineHeight": "1.3" },
    "nodeTitle": { "size": "14px", "weight": "600", "lineHeight": "1.2" },
    "nodeSubtitle": { "size": "10px", "weight": "500", "lineHeight": "1.2" },
    "body": { "size": "12px", "weight": "400", "lineHeight": "1.5" },
    "mono": { "size": "11px", "family": "'JetBrains Mono', monospace" }
  },
  "layout": {
    "headerHeight": 58,
    "bottomDockHeight": 64,
    "sidebarWidth": 264,
    "sidebarCompactWidth": 64,
    "zLayers": {
      "background": 0,
      "canvasGrid": 1,
      "edges": 2,
      "nodes": 3,
      "nodeLabels": 4,
      "overlays": 5,
      "floatingPanels": 10,
      "dock": 20,
      "header": 25,
      "dialogs": 100
    }
  },
  "effects": {
    "blurGlow": "filter: drop-shadow(0 0 8px rgba(39, 223, 244, 0.5))",
    "coreGlow": "radial-gradient(circle, #ffcc68 0%, #075870 25%, #05121d 50%, #20dfee 52%, #061625 56%)",
    "glassPanel": "backdrop-filter: blur(12px); background: linear-gradient(145deg, rgba(13, 40, 56, 0.95), rgba(4, 18, 32, 0.95)); border: 1px solid #22748b"
  }
}
