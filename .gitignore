# Third-party dependencies (installable via pnpm install)
node_modules/
node_modules
**/node_modules/
**/node_modules
/.pnp
.pnp.*

# Next.js build and webpack cache (files >100MB like 0.pack)
.next/
**/.next/
**/.next
**/.next*/
**/.next*
/out/
**/out/

# Flutter native compilation cache (files >100MB like libflutter.so)
**/.dart_tool/
**/.flutter-plugins*
**/.pub-cache/
**/.pub/
**/build/
**/ephemeral/

# PocketBase live socket/WAL/HTTP-log files (>100MB)
# Note: The database is backed up in pb_data/backups/data.db.gz.part_*
**/pb_data/auxiliary.db*
**/pb_data/*.db-shm
**/pb_data/*.db-wal
**/pb_data/data.db

# Live flight search transient API cache (1.6GB of 30-min cached query responses)
**/flights-cache/

# System / OS temp files
.DS_Store
**/.DS_Store
*.pyc
**/*.pyc
__pycache__/
**/__pycache__/
.user.ini

# TypeScript build info
*.tsbuildinfo
**/*.tsbuildinfo
next-env.d.ts
**/next-env.d.ts

# IDE workspace state
.cursor/
**/.cursor/
.claude/
**/.claude/
.idea/
**/.idea/
*.iml
**/*.iml
**/postiz-app/
**/redis-data/
