# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# PocketBase runtime data and binary (keep migrations)
pocketbase/pb_data/
pocketbase/pocketbase
pocketbase/*.zip

# server-side secrets & runtime config (Gemini API key, server-env, etc.)
.data/
data/server-env.json

# Lonaliza hotel-engine (secrets, build, crawlee storage)
hotel-engine/node_modules/
hotel-engine/dist/
hotel-engine/.env
hotel-engine/storage/
hotel-engine/redis-data/
hotel-engine/redis.conf
hotel-engine/wg/*.key
hotel-engine/wg/*.key
hotel-engine/wg/wg-lonaliza.conf
hotel-engine/wg/phone.conf

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# IDE / local agent (MCP tokens, workspace state)
.cursor/
.claude/

# extra credential / key material
*.key
credentials.json
**/mcp-secrets*

# Let's Encrypt challenge leftovers
.well-known/acme-challenge/

# Nested dependencies and packaged builds
**/node_modules/
*.apk
*.ipa

# Flutter generated local machine paths
Lonalizamobilapp/ios/Flutter/ephemeral/
Lonalizamobilapp/ios/Flutter/Generated.xcconfig
Lonalizamobilapp/ios/Flutter/flutter_export_environment.sh
