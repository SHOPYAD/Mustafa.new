# Copy to .env.local for local/production deploys — OR set keys from the
# Admin panel (Integrations / PocketBase). Admin save writes `.data/server-env.json`
# and merges into `.env.local`. Never commit real secrets.
#
# Priority at runtime: process.env (incl. OS / hosting) → `.data/server-env.json`
# Tracking pixels also load via GET /api/tracking-config (no restart needed).
# Some NEXT_PUBLIC_* client bundles may still need a server restart after save.

# --- Gemini (existing) ---
GEMINI_API_KEY=

# --- Admin password login (optional fallback) ---
NEXT_PUBLIC_ADMIN_USERNAME=admin
NEXT_PUBLIC_ADMIN_PASSWORD=changeme
# Optional shared secret for admin API writes (header x-admin-setup-secret)
ADMIN_SETUP_SECRET=
# Comma-separated Google emails allowed into admin (empty = allow any after OAuth)
NEXT_PUBLIC_ADMIN_EMAILS=

# --- Site URL (used for OAuth redirects / Search Console property hint) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- PocketBase (bookings, customers, Google Auth) ---
# Prefer Admin → PocketBase. Server talks to the internal URL.
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=
POCKETBASE_GOOGLE_ENABLED=false
POCKETBASE_GOOGLE_CLIENT_ID=
POCKETBASE_GOOGLE_CLIENT_SECRET=

# --- Marketing / SEO tracking (public IDs only; enabled when ID is set) ---
# Prefer Admin → Integrations → «حفظ على السيرفر»
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Optional explicit enable flags (true|false). If omitted, valid IDs auto-enable.
# NEXT_PUBLIC_GSC_ENABLED=
# NEXT_PUBLIC_GA_ENABLED=
# NEXT_PUBLIC_GTM_ENABLED=
# NEXT_PUBLIC_GOOGLE_ADS_ENABLED=
# NEXT_PUBLIC_META_PIXEL_ENABLED=
# NEXT_PUBLIC_TIKTOK_PIXEL_ENABLED=

# --- Flights provider (live Sky Scrapper vs Travelpayouts white-label) ---
# Prefer Admin → Flights → «حفظ على السيرفر»
# Values: live | travelpayouts | both  (internal is treated as live)
NEXT_PUBLIC_FLIGHTS_PROVIDER=travelpayouts
# Dedicated Sky Scrapper key — do not reuse hotel RapidAPI keys
SKY_SCRAPPER_RAPIDAPI_KEY=
SKY_SCRAPPER_HOST=sky-scrapper.p.rapidapi.com
NEXT_PUBLIC_TRAVELPAYOUTS_MARKER=
NEXT_PUBLIC_TRAVELPAYOUTS_TRS=
NEXT_PUBLIC_TRAVELPAYOUTS_DOMAIN=lonaliza.com
NEXT_PUBLIC_TRAVELPAYOUTS_WIDGET_DOMAIN=
NEXT_PUBLIC_TRAVELPAYOUTS_EMBED_SCRIPT=
NEXT_PUBLIC_TRAVELPAYOUTS_COOKIE_SCRIPT=
NEXT_PUBLIC_TRAVELPAYOUTS_LOCALE=ar
NEXT_PUBLIC_TRAVELPAYOUTS_CURRENCY=usd
NEXT_PUBLIC_TRAVELPAYOUTS_LINK_COLOR=#f59e0b

# --- Transfers provider (internal cards vs Travelpayouts tpemb widget) ---
# Prefer Admin → Transfers → «حفظ على السيرفر»
# Official widget: shmarker 324632.324632, TRS 489039, promo 1504, locale=en.
NEXT_PUBLIC_TRANSFERS_PROVIDER=travelpayouts
NEXT_PUBLIC_TRANSFERS_TP_MARKER=324632.324632
NEXT_PUBLIC_TRANSFERS_TP_TRS=489039
NEXT_PUBLIC_TRANSFERS_TP_LOCALE=en
NEXT_PUBLIC_TRANSFERS_TP_CURRENCY=usd
NEXT_PUBLIC_TRANSFERS_TP_CAMPAIGN_ID=22
NEXT_PUBLIC_TRANSFERS_TP_PROMO_ID=1504
NEXT_PUBLIC_TRANSFERS_TP_COLOR_SCHEME=blue
NEXT_PUBLIC_TRANSFERS_TP_HEADER=نوفر لكم أرخص الأسعار لترانسفير المطار في عموم تركيا
NEXT_PUBLIC_TRANSFERS_TP_FLAGS=
NEXT_PUBLIC_TRANSFERS_TP_SCRIPT=

# --- Cars provider (internal placeholder vs Travelpayouts car-rental widget) ---
# Prefer Admin → Cars → «حفظ على السيرفر»
# Cars TRS is 489039; shmarker may be compound 324632.566091.
NEXT_PUBLIC_CARS_PROVIDER=travelpayouts
NEXT_PUBLIC_CARS_TP_MARKER=324632.566091
NEXT_PUBLIC_CARS_TP_TRS=489039
NEXT_PUBLIC_CARS_TP_LOCALE=ar
NEXT_PUBLIC_CARS_TP_COUNTRY=109
NEXT_PUBLIC_CARS_TP_CITY=65991
NEXT_PUBLIC_CARS_TP_CAMPAIGN_ID=87
NEXT_PUBLIC_CARS_TP_PROMO_ID=2466
NEXT_PUBLIC_CARS_TP_SCRIPT=

# --- Hotels provider (Travel Advisor list + Booking COM 15 rooms) ---
# Prefer Admin → Hotels. RapidAPI key stays on the server.
NEXT_PUBLIC_HOTELS_PROVIDER=internal
RAPIDAPI_KEY=
RAPIDAPI_TRAVEL_ADVISOR_HOST=travel-advisor.p.rapidapi.com
# Rooms: subscribe separately at https://rapidapi.com/DataCrawler/api/booking-com15
NEXT_PUBLIC_HOTELS_ROOMS_PROVIDER=booking_com15
BOOKING_COM_HOST=booking-com15.p.rapidapi.com
RAPIDAPI_ROOMS_HOST=booking-com15.p.rapidapi.com
# BOOKING_COM_RAPIDAPI_KEY=
# RAPIDAPI_ROOMS_KEY=

# Owned hotel engine (Lonaliza NestJS on 127.0.0.1:3051). Never share liotrip Redis/tokens.
# HOTEL_ENGINE_URL=http://127.0.0.1:3051
# HOTEL_ENGINE_TOKEN=

# --- AUTO-COMMS: WhatsApp Cloud API + Telegram (tokens also saved in .data/comms-settings.json) ---
# Prefer Admin → رسائل واتساب/تيليجرام. Never commit real tokens.
# WHATSAPP_CLOUD_PHONE_NUMBER_ID=
# WHATSAPP_CLOUD_ACCESS_TOKEN=
# WHATSAPP_CLOUD_WABA_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_OTP_TEMPLATE=otp_code
# WHATSAPP_TRANSACTIONAL_TEMPLATE=
# WHATSAPP_MARKETING_TEMPLATE=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_DEFAULT_CHAT_ID=
# COMMS_OTP_ENABLED=false

# --- Organic social publish (Admin → حسابات النشر). Tokens live in .data/social/tokens.json ---
# Meta Graph: Facebook Page + Instagram (instagram_content_publish)
# Redirect: {NEXT_PUBLIC_SITE_URL}/api/oauth/meta/callback
META_APP_ID=
META_APP_SECRET=
# META_GRAPH_VERSION=v21.0
# YouTube Data API upload (organic). Google Ads login is Agent ADS — not these keys.
# Redirect: {NEXT_PUBLIC_SITE_URL}/api/oauth/youtube/callback
GOOGLE_YOUTUBE_CLIENT_ID=
GOOGLE_YOUTUBE_CLIENT_SECRET=
# TikTok Content Posting API — leave empty to stub (no fake publish)
# Redirect: {NEXT_PUBLIC_SITE_URL}/api/oauth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Optional HMAC secret for OAuth state (falls back to ADMIN_SESSION_SECRET)
# SOCIAL_OAUTH_STATE_SECRET=
