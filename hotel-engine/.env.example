# Lonaliza hotel-engine only. Never copy values from liotrip.
ENGINE_HOST=127.0.0.1
ENGINE_PORT=3051
ENGINE_TOKEN=change-me

REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=change-me
REDIS_KEY_PREFIX=lonaliza:hotels:

# SOCKS on the phone's WireGuard IP after the tunnel is up.
# Example: socks5://10.88.0.2:1080
HOTEL_PROXY_URL=

WG_INTERFACE=wg-lonaliza
WG_PEER_IP=10.88.0.2

POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

CRAWLEE_STORAGE_DIR=/app/storage
CRAWLEE_PURGE_ON_START=1
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
# Optional: use the server Chromium instead of a Playwright download
# CHROMIUM_PATH=/snap/bin/chromium
