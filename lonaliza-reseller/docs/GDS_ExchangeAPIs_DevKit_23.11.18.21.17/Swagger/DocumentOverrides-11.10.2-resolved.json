              "type": "string"
            }
          },
          "DocumentType": {
            "$ref": "#/components/schemas/DocumentTypeEnum"
          }
        }
      },
      "DocumentTypeEnum": {
        "type": "string",
        "description": "Document type like EMD, MCO",
        "example": "Ticket",
        "enum": [
          "EMD",
          "MCO",
          "Ticket"
        ]
      },
      "TourCodes": {
        "required": [
          "TourCode"
        ],
        "properties": {
          "@type": {
            "type": "string",
            "example": "TourCodes"
          },
          "TravelerIdentifierRef": {
