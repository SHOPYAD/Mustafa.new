          "Islands and Countries of the Caribbean",
          "South America",
          "Europe",
          "Africa",
          "Middle East / Western Asia",
          "Asia",
          "Australia / New Zealand / Pacific Islands",
          "Canada and Greenland"
        ]
      },
      "PurposeEnum": {
        "type": "string",
        "enum": [
          "Business",
          "Pleasure",
          "Charter Service"
        ]
      },
      "Restrictions": {
        "required": [
