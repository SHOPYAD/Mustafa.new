          },
          "id": {
            "type": "string",
            "description": "A locally referenced ID"
          },
          "description": {
            "type": "string",
            "description": "Descriptive text used to identify the contents of a target object"
          },
          "uris": {
            "type": "array",
            "description": "Uniform Resource Identifier",
            "items": {
              "type": "string",
              "example": "google.com"
            }
          }
        }
      },
      "Commission": {
        "required": [
