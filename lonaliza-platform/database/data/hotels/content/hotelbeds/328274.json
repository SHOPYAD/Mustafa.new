{"supplier":"hotelbeds","supplierHotelId":"328274","name":"Odeon Hotel","description":"يتمتع فندق Odéon Hôtel by Malone بموقع مركزي في باريس، على بُعد مسافة قصيرة سيرًا على الأقدام من حدائق لوكسمبورغ وكاتدرائية نوتردام. يوفر هذا الفندق 35 غرفة مكيفة مع أجهزة تلفزيون بشاشات مسطحة، وإنترنت سلكي ولاسلكي مجاني، وحمامات خاصة مع دُشّ ولوازم استحمام مجانية. يمكن للضيوف الاستمتاع ببوفيه إفطار (مقابل رسوم)، وتناول وجبة خفيفة في مطعم الوجبات الخفيفة/البقالة، والاسترخاء مع مشروب في البار/الاستراحة. كما تتوفر خدمة البوّاب والتنظيف الجاف. تشمل مناطق الجذب السياحي القريبة متحف اللوفر وسراديب الموتى في باريس.","address":"RUE DE L'ODÉON, 3, PARIS,75006, 3","city":"PARIS","countryCode":"FR","postalCode":"75006","lat":48.85143,"lng":2.338811,"stars":3,"giataCode":"262120","phone":"33143259067","email":"odeon@odeonhotel.fr","website":"http://www.odeonhotel.fr/","images":[{"url":"https://photos.hotelbeds.com/giata/bigger/32/328274/328274a_hb_a_059.jpg?20250113150112?20250617191712","category":"exterior","order":0},{"url":"https://photos.hotelbeds.com/giata/bigger/32/328274/328274a_hb_a_055.jpg?20250113150112?20250617191711","category":"exterior","order":1},{"url":"https://photos.hotelbeds.com/giata/bigger/32/328274/328274a_hb_a_062.jpg?20250113150112?20250617191712","category":"exterior","order":2},{"url":"https://photos.hotelbeds.com/giata/bigger/32/328274/328274a_hb_a_043.jpg?20250113150113?20250617191713","category":"exterior","order":3},{"url":"https://photos.hotelbeds.com/giata/bigger/32/328274/328274a_hb_a_044.jpg?20250113150113?20250617191712","category":"exterior","order":4},{"url":"https://photos.hotelbeds.com/giata/bigger/32/328274/328274a_hb_a_045.jpg?20250113150113?20250617191712","category":"exterior","order":5},{"url":"https://photos.hotelbeds.com/giata/bigger/32/328274/328274a_hb_a_067.jpg?20250113150113?20250617191710","category":"exterior","order":6},{"url":"https://photos.hotelbeds.com/giata/bigger/32/328274/328274a_hb_a_046.jpg?20250113150113?20250617191712","categor