{"supplier":"hotelbeds","supplierHotelId":"83971","name":"Hotel De Moc","description":"يقع فندق De' Moc، وهو خيار عصري واقتصادي، في موقع مثالي على طريق Prajatipatai بالقرب من تقاطع Visutkasatra، مقابل معبد Trithotsatheap. يبعد الفندق مسافة 5 دقائق فقط سيرًا على الأقدام عن طريق Khaosan Road النابض بالحياة في جزيرة Rattanakosin التاريخية في بانكوك، ويتمتع الضيوف بإمكانية الوصول بسهولة إلى أماكن التسوق والمعالم السياحية. يقع مطارا Don Muang وSuvarnabhumi على بُعد 25 كم و35 كم على التوالي. تتميز غرف الفندق الـ 90 المجهزة تجهيزًا جيدًا بطراز معماري معاصر. يمكن للضيوف الاسترخاء في المسبح الخارجي، أو الاستمتاع بمشروب في البار في الهواء الطلق، أو ممارسة التمارين الرياضية في صالة الألعاب الرياضية، أو الاستمتاع بعلاجات السبا والمساج. يتوفر بوفيه إفطار يوميًا. يوفر De' Moc أماكن إقامة مريحة في موقع متميز بسعر معقول.","address":"78 Prajatipatai Rd., 78","city":"Bangkok","countryCode":"TH","postalCode":"10200","lat":13.761591,"lng":100.504187,"stars":3,"chain":"BUDDG","giataCode":"125378","phone":"6622822841","email":"booking@hotmail.com","website":"http://www.hoteldemoc.com","images":[{"url":"https://photos.hotelbeds.com/giata/bigger/08/083971/083971a_hb_a_011.jpg","category":"exterior","order":0},{"url":"https://photos.hotelbeds.com/giata/bigger/08/083971/083971a_hb_a_001.jpg","category":"exterior","order":1},{"url":"https://photos.hotelbeds.com/giata/bigger/08/083971/083971a_hb_l_004.jpg","category":"lobby","order":2},{"url":"https://photos.hotelbeds.com/giata/bigger/08/083971/083971a_hb_w_012.jpg","category":"room","order":3},{"url":"https://photos.hotelbeds.com/giata/bigger/08/083971/083971a_hb_w_007.jpg","category":"room","order":4},{"url":"https://photos.hotelbeds.com/giata/bigger/08/083971/083971a_hb_w_002.jpg","category":"room","order":5},{"url":"https://photos.hotelbeds.com/giata/bigger/08/083971/083971a_hb_p_003.jpg","category":"pool","order":6},{"url":"https://photos.hotelbeds.com/giata/bigger/08/083971/083971a_hb_r_010.jpg","category":"restaurant","order":7},{"url":