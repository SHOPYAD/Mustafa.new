{"supplier":"hotelbeds","supplierHotelId":"111237","name":"Le Twelve","description":"يقع هذا الفندق ذو الـ 3 نجوم في منطقة هادئة في الدائرة الثانية عشرة في باريس، ويوفر قاعدة هادئة مع أجواء مناسبة للعائلات. يقع مكان الإقامة على بُعد 10 دقائق سيرًا على الأقدام من كل من ساحة الأمة وحديقة بوا دو فينسين. يمكن للضيوف الاستمتاع بحديقة هادئة وفناء، ويوفر الفندق خدمة الواي فاي المجانية ومواقف خاصة للسيارات في الموقع مقابل رسوم. تشمل خيارات الإقامة غرفًا فردية ومزدوجة وثلاثية ورباعية، تلبي احتياجات المسافرين بمفردهم والأزواج والعائلات. تتميز بعض الغرف بإطلالات على الحديقة. لاستكشاف المدينة، تقع محطة مترو بورت دو فينسين على بُعد 5 دقائق سيرًا على الأقدام، مما يوفر وصلات مباشرة إلى وسط باريس.","address":"Avenue Du Docteur Arnold Netter, 82","city":"PARIS","countryCode":"FR","postalCode":"75012","lat":48.846402,"lng":2.406308,"stars":3,"giataCode":"145098","phone":"0143437850","email":"contact@hotel-twelve.com","website":"www.hotel-twelve.com","images":[{"url":"https://photos.hotelbeds.com/giata/bigger/11/111237/111237a_hb_a_005.jpg?20241208180011","category":"exterior","order":0},{"url":"https://photos.hotelbeds.com/giata/bigger/11/111237/111237a_hb_a_006.jpg?20250205124507","category":"exterior","order":1},{"url":"https://photos.hotelbeds.com/giata/bigger/11/111237/111237a_hb_a_007.jpg?20241013141510","category":"exterior","order":2},{"url":"https://photos.hotelbeds.com/giata/bigger/11/111237/111237a_hb_a_017.jpg?20250403200013","category":"exterior","order":3},{"url":"https://photos.hotelbeds.com/giata/bigger/11/111237/111237a_hb_a_018_20251125_013939.jpg","category":"exterior","order":4},{"url":"https://photos.hotelbeds.com/giata/bigger/11/111237/111237a_hb_a_019_20260213_162420.jpg","category":"exterior","order":5},{"url":"https://photos.hotelbeds.com/giata/bigger/11/111237/111237a_hb_a_020_20260213_162426.jpg","category":"exterior","order":6},{"url":"https://photos.hotelbeds.com/giata/bigger/11/111237/111237a_hb_a_021_20260213_163025.jpg","category":"exterior","order":7},