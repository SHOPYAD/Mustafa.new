{"supplier":"hotelbeds","supplierHotelId":"677511","name":"فندق سوكومفيت 20","description":"توقف في فندق Sukhumvit 20 لاكتشاف روائع بانكوك. يقدم الفندق مجموعة واسعة من وسائل الراحة والمزايا لضمان قضاء وقت ممتع. ستجد في الفندق خدمة الواي فاي المجانية في جميع الغرف، ومكتب استقبال يعمل على مدار 24 ساعة، وخدمة تسجيل الوصول/المغادرة السريع، وخدمة تخزين الأمتعة، وخدمة الواي فاي في المناطق العامة. تضمن لك غرف الضيوف المريحة نومًا هانئًا، وتتميز بعض الغرف بمرافق مثل شاشة تلفزيون LCD/بلازما، ورف للملابس، وقهوة سريعة مجانية، وشاي مجاني، ومرآة. خذ قسطًا من الراحة من يوم طويل واستمتع بخدمة المساج. يجمع فندق Sukhumvit 20 بين الراحة والملاءمة، مما يجعله الخيار الأمثل لإقامتك في بانكوك.","address":"64/1 sukhumvit soi 20","city":"Bangkok","countryCode":"TH","postalCode":"10110","lat":13.730835,"lng":100.563802,"stars":3,"giataCode":"473020","phone":"+66830824177","images":[{"url":"https://photos.hotelbeds.com/giata/bigger/67/677511/677511a_hb_a_001.jpg","category":"exterior","order":0},{"url":"https://photos.hotelbeds.com/giata/bigger/67/677511/677511a_hb_a_002.jpg","category":"exterior","order":1},{"url":"https://photos.hotelbeds.com/giata/bigger/67/677511/677511a_hb_a_003.jpg","category":"exterior","order":2},{"url":"https://photos.hotelbeds.com/giata/bigger/67/677511/677511a_hb_a_004.jpg","category":"exterior","order":3},{"url":"https://photos.hotelbeds.com/giata/bigger/67/677511/677511a_hb_w_001.jpg","category":"room","order":4}],"facilities":[{"group":"مرافق","name":"استقبال 24 ساعة","code":"70-30"},{"group":"مرافق","name":"واي فاي","code":"70-550"},{"group":"مرافق","name":"خدمه النقل من و الي المطار","code":"70-562","fee":true},{"group":"مرافق","name":"خدمة الغرف","code":"70-270","fee":true},{"group":"مرافق","name":"خدمة غسيل الملابس","code":"70-280"},{"group":"مرافق","name":"خدمة مجالسة الاطفال","code":"70-485","fee":true},{"group":"مرافق","name":"خدمه نقل الحقائب","code":"70-525","fee":true},{"group":"مرافق","name":"صندوق حفظ المقتنيات الثمينه","code":"70-40","fee":true},{"