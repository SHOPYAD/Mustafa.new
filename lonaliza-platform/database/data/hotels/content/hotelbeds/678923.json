{"supplier":"hotelbeds","supplierHotelId":"678923","name":"Setia Inn","description":"يُقدم فندق Setia Inn ذو النجمة ونصف الراحة والسهولة سواءً كنت في رحلة عمل أو عطلة في كلانج. يوفر الفندق للنزلاء مجموعة من الخدمات ووسائل الراحة المُصممة لتوفير الراحة والطمأنينة. ستجد في الفندق خدمة الواي فاي المجانية في جميع الغرف، ومكتب استقبال يعمل على مدار 24 ساعة، وخدمة الواي فاي في المناطق العامة، وموقف سيارات، وخدمة الغرف. تم تصميم غرف الضيوف المختارة بعناية لتوفير الراحة، وهي مُجهزة بشاشة تلفزيون LCD/بلازما، ورف للملابس، وبياضات أسرّة، ومرآة، ومناشف لضمان ليلة نوم هانئة. يوفر الفندق أيضاً خيارات ترفيهية مُتنوعة. تُعد الراحة والسهولة التي يوفرها فندق Setia Inn الخيار الأمثل لإقامتك في كلانج.","address":"Suite 3A 2 Setia Avenue No 2 Jalan Setia Prima S U","city":"KLANG","countryCode":"MY","postalCode":"00000","lat":3.104446,"lng":101.443398,"stars":2,"giataCode":"456842","phone":"+60333623830","images":[{"url":"https://photos.hotelbeds.com/giata/bigger/67/678923/678923a_hb_a_001.jpg","category":"exterior","order":0},{"url":"https://photos.hotelbeds.com/giata/bigger/67/678923/678923a_hb_a_002.jpg","category":"exterior","order":1},{"url":"https://photos.hotelbeds.com/giata/bigger/67/678923/678923a_hb_a_003.jpg","category":"exterior","order":2},{"url":"https://photos.hotelbeds.com/giata/bigger/67/678923/678923a_hb_a_004.jpg","category":"exterior","order":3},{"url":"https://photos.hotelbeds.com/giata/bigger/67/678923/678923a_hb_l_001.jpg","category":"lobby","order":4},{"url":"https://photos.hotelbeds.com/giata/bigger/67/678923/678923a_hb_l_002_20260227_135825.jpg","category":"lobby","order":5},{"url":"https://photos.hotelbeds.com/giata/bigger/67/678923/678923a_hb_l_003_20260227_135826.jpg","category":"lobby","order":6},{"url":"https://photos.hotelbeds.com/giata/bigger/67/678923/678923a_hb_l_004_20260227_135826.jpg","category":"lobby","order":7},{"url":"https://photos.hotelbeds.com/giata/bigger/67/678923/678923a_hb_l_005_20260227_135827.jpg","category":"lobby","order":8}],"faciliti