{"supplier":"hotelbeds","supplierHotelId":"80319","name":"Kantary House Ramkamhaeng Hotel","description":"يقع هذا الفندق ذو الشقق الفندقية على بُعد 15 كم فقط من مطار سوفارنابومي في بانكوك، في منطقة سريناكارين-رامكامهاينج، ويضم 184 شقة بغرفة نوم واحدة أو غرفتي نوم. يمكن للضيوف الاستمتاع بخدمة الواي فاي المجانية في المناطق العامة، واستراحة رجال الأعمال مع المرطبات المجانية، ومكتب استقبال يعمل على مدار 24 ساعة. يتميز الفندق بمطعم ومرافق للمؤتمرات وخدمات الغرف والغسيل ومواقف للسيارات في الموقع. تتميز كل شقة بغرف معيشة وطعام واسعة ومطبخ مجهز بالكامل أو مطبخ صغير وحمام خاص وخدمة إنترنت. للاسترخاء، يمكن للضيوف الاستفادة من المسبح الخارجي المُدفأ والساونا والحمام البخاري. كما يتوفر بوفيه إفطار يومي.","address":"14 Ramkamhaeng 42 Road, Bangkapi, 14","city":"Bangkok","countryCode":"TH","postalCode":"10240","lat":13.76019,"lng":100.64026,"stars":3,"chain":"KHG","giataCode":"100372","phone":"006623745544#257","email":"reservations@kantaryhouse-bangkok.com","website":"www.kantarygroup.com","images":[{"url":"https://photos.hotelbeds.com/giata/bigger/08/080319/080319a_hb_a_001_20250527_034408.JPG","category":"exterior","order":0},{"url":"https://photos.hotelbeds.com/giata/bigger/08/080319/080319a_hb_a_002_20250527_034415.jpg","category":"exterior","order":1},{"url":"https://photos.hotelbeds.com/giata/bigger/08/080319/080319a_hb_l_001_20250527_034843.JPG","category":"lobby","order":2},{"url":"https://photos.hotelbeds.com/giata/bigger/08/080319/080319a_hb_ro_001_20250527_031449.JPG","roomCode":"TWN.ST-1","category":"room","order":3},{"url":"https://photos.hotelbeds.com/giata/bigger/08/080319/080319a_hb_ro_002_20250527_031606.jpg","roomCode":"TWN.ST-1","category":"room","order":4},{"url":"https://photos.hotelbeds.com/giata/bigger/08/080319/080319a_hb_ro_003_20250527_031615.jpg","roomCode":"TWN.ST-1","category":"room","order":5},{"url":"https://photos.hotelbeds.com/giata/bigger/08/080319/080319a_hb_ro_004_20250527_031622.jpg","roomCode":"TWN.ST-1","category":"room","order":6},{"url":"