{"supplier":"hotelbeds","supplierHotelId":"995416","name":"Invite Hotel Corner Trabzon","description":"يتمتع فندق Invite Hotel Corner Trabzon بموقع جيد في طرابزون، ويضم غرفًا مكيفة مع خدمة الواي فاي المجانية ومواقف خاصة مجانية للسيارات وخدمة الغرف. تشمل المرافق المختلفة المتوفرة في هذه الملكية حديقة وصالة مشتركة ومطعمًا. يوفر مكان الإقامة مكتب استقبال يعمل على مدار 24 ساعة وخدمة الكونسيرج وتحويل العملات للضيوف. تحتوي جميع الغرف في الفندق على مكتب وتلفزيون بشاشة مسطحة وحمام خاص وبياضات أسرّة ومناشف. تحتوي الغرف على غلاية كهربائية، بينما توفر بعض الغرف تراسًا وتوفر غرف أخرى إطلالات على المدينة. تحتوي جميع الغرف على خزانة ملابس. يقدم فندق Invite Hotel Corner Trabzon بوفيه إفطار أو وجبة إفطار حلال. تشمل نقاط الاهتمام الشهيرة القريبة من مكان الإقامة Çarşı Cami ومتحف طرابزون وTrabzon Kalesi. يقع أقرب مطار، وهو مطار طرابزون، على بُعد 4 كم من فندق Invite Hotel Corner Trabzon.","address":"Sahil Yolu Caddesi, 31","city":"Ortahisar","countryCode":"TR","postalCode":"61100","lat":41.008434,"lng":39.726574,"stars":4,"giataCode":"1339437","phone":"+904625001500","email":"fatihdumanoglu@inviteotel.com","website":"www.inviteotel.com","images":[{"url":"https://photos.hotelbeds.com/giata/bigger/99/995416/995416a_hb_a_001.jpg","category":"exterior","order":0},{"url":"https://photos.hotelbeds.com/giata/bigger/99/995416/995416a_hb_a_002.jpg","category":"exterior","order":1},{"url":"https://photos.hotelbeds.com/giata/bigger/99/995416/995416a_hb_a_003.jpg","category":"exterior","order":2},{"url":"https://photos.hotelbeds.com/giata/bigger/99/995416/995416a_hb_a_004.jpg","category":"exterior","order":3},{"url":"https://photos.hotelbeds.com/giata/bigger/99/995416/995416a_hb_a_005.jpg","category":"exterior","order":4},{"url":"https://photos.hotelbeds.com/giata/bigger/99/995416/995416a_hb_a_006.jpg","category":"exterior","order":5},{"url":"https://photos.hotelbeds.com/giata/bigger/99/995416/995416a_hb_a_007.jpg","category":"exterior","order":6},{"url":"https://photos.hotelbeds.com/giata/bigger/