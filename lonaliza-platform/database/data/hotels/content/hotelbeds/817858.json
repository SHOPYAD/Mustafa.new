{"supplier":"hotelbeds","supplierHotelId":"817858","name":"Backpack Station Hostel","description":"لدى الإقامة في باكباك ستاشن - دار ضيافة في بانكوك (ساكومفيت)، ستكون على بُعد خمس دقائق بالسيارة من مركز إمبوريوم للتسوق وجامعة بانكوك. الإقامة في فندق شباب تضعك على بُعد ٥٫٧ كم من مركز تيرمنال 21 للتسوق و٦٫١ كم من ميدان نانا. استمتع بمشاهدة المناظر المتاحة من الشرفة وتمتع باستخدام وسائل الراحة المتوفرة مثل اتصال لاسلكي مجاني بالإنترنت وتلفاز في المنطقة المشتركة. تضم وسائل الرائحة المميزة خدمة تخزين الأمتعة وتجهيزات لغسل الملابس وقهوة/شاي في منطقة مشتركة. في فندق الشباب هذا، يتم تقديم المأكولات في الكافيتيريا حيث يمكنك الاستمتاع بوجبة شهية. أنهِ يومك بتناول مشروب مُنعش في البار/الاستراحة. اشعر وكأنك في منزلك عند الإقامة في واحدة من 11 غرفة/غرف ضيافة مكيفة. تتاح لك اتصال لاسلكي بالإنترنت مجانًا لتبقى على اتصال دائمًا.","address":"Sukhumvit 71 Road 24 24 1 Soi Pridi Banomyoung 2","city":"BANGKOK","countryCode":"TH","postalCode":"10110","lat":13.714599,"lng":100.595834,"stars":2,"giataCode":"728947","phone":"+66954917973","images":[{"url":"https://photos.hotelbeds.com/giata/bigger/81/817858/817858a_hb_a_001.jpg","category":"exterior","order":0},{"url":"https://photos.hotelbeds.com/giata/bigger/81/817858/817858a_hb_a_002.jpg","category":"exterior","order":1},{"url":"https://photos.hotelbeds.com/giata/bigger/81/817858/817858a_hb_a_003.jpg","category":"exterior","order":2},{"url":"https://photos.hotelbeds.com/giata/bigger/81/817858/817858a_hb_a_004.jpg","category":"exterior","order":3},{"url":"https://photos.hotelbeds.com/giata/bigger/81/817858/817858a_hb_l_001.jpg","category":"lobby","order":4},{"url":"https://photos.hotelbeds.com/giata/bigger/81/817858/817858a_hb_l_002.jpg","category":"lobby","order":5},{"url":"https://photos.hotelbeds.com/giata/bigger/81/817858/817858a_hb_w_005.jpg","category":"room","order":6},{"url":"https://photos.hotelbeds.com/giata/bigger/81/817858/817858a_hb_w_006.jpg","category":"room","order":7},{"url":"https://photos.hotelbeds.com/giata/bigger/81/