{"supplier":"hotelbeds","supplierHotelId":"1109054","name":"Buyuk Kale Hotel","description":"لدى الإقامة في بويوك كيل هوتل بمدينة كارس، ستكون على بُعد 5 دقائق مشيا من Health Directorate Building وMazlum Ağa Hamam. استمتع بالإقامة في هذا الفندق على بُعد ٠٫٤ كم من كنيسة الرسل و٠٫٤ كم من متحف كارس. استمتع بفرص الترفيه المتاحة، ومنها ساونا أو تمتع بالاستفادة من وسائل الترفيه الأخرى المتاحة مثل اتصال لاسلكي مجاني بالإنترنت. تضم وسائل الراحة المتاحة مكتب استقبال مفتوح 24 ساعة وخزانة للأمانات في مكتب الاستقبال. يتاح خدمة صف السيارات بمعرفة الفندق مجانا داخل موقع المنشأة. تلذّذ بأشهى المأكولات لدى تناولك وجبة الغداء أو العشاء في مطعم منشأة فندقية. كما يمكنك الإقامة هنا للاسترخاء في غرفتك والاستفادة من خدمة الغرف على مدار 24 ساعة. يتم تقديم بوفيه فطور مجانًا يوميًا من 7 صباحًا إلى 10 صباحًا. اشعر وكأنك في منزلك عند الإقامة في واحدة من 50 غرفة ضيافة مكيفة تحتوي على ثلاجات وتلفزيون إل سي دي. يُتاح لك اتصال لاسلكي بالإنترنت مجانًا لتبقى على اتصال دائمًا، بالإضافة إلى قنوات فضائية من أجل متعتك. تضم الغرف حمامات خاصة بها تجهيزات دش مع مستلزمات مجانية للعناية الشخصية ومجففات شعر. تشتمل وسائل الراحة المتاحة على هواتف، بالإضافة إلى خزنات تتّسع لتخزين الكمبيوتر المحمول ومكاتب.","address":"Yusufpasa Mahallesi","city":"Kars","countryCode":"TR","lat":40.60826,"lng":43.09311,"giataCode":"486843","phone":"+904742126444","images":[{"url":"https://photos.hotelbeds.com/giata/bigger/11/1109054/1109054a_hb_a_001_20260311_091157.jpg","category":"exterior","order":0},{"url":"https://photos.hotelbeds.com/giata/bigger/11/1109054/1109054a_hb_a_002_20260311_091205.jpg","category":"exterior","order":1},{"url":"https://photos.hotelbeds.com/giata/bigger/11/1109054/1109054a_hb_w_001_20260311_091141.jpg","category":"room","order":2},{"url":"https://photos.hotelbeds.com/giata/bigger/11/1109054/1109054a_hb_w_002_20260311_091141.jpg","category":"room","order":3},{"url":"https://photos.hotelbeds.com/giata/bigger/11/1109054/1109054a_hb_w_003_20260311_091149.jpg","category":"room","order":4},{"url":"https://ph