{"supplier":"hotelbeds","supplierHotelId":"64220","name":"The Bristol Hotel Dubai","description":"يتمتع هذا الفندق الحصري بموقعٍ مثالي في قلب ديرة، وهي منطقةٌ في مدينة دبي، في الإمارات العربية المتحدة. يُحيط بالفندق عددٌ من المعالم السياحية التي تُمتّع الحواس، بما في ذلك سوق الذهب في دبي، ومسجد جميرا، وحديقة دبي للذهب والألماس. ستجدون بالقرب من الفندق مجموعةً واسعة من المطاعم المُغرية، بينما يُمكن لعشاق رياضة الجولف قضاء يومٍ رائع في ملاعب الجولف المجاورة. يوفر هذا الفندق الرائع غرفاً وأجنحة فاخرة مُجهزة بوسائل راحة فخمة وخدماتٍ من الدرجة الأولى لإرضاء أذواق المسافرين الأكثر تطلباً. تشمل المرافق الشاملة مجموعةً واسعة من المطاعم التي تُقدم مأكولاتٍ عالمية، بالإضافة إلى العديد من البارات المُثالية لقضاء يومٍ على حمام السباحة أو بدء يومك بفنجان قهوة فاخر. يُعدّ مركز اللياقة البدنية ومنطقة السبا الخيار الأمثل للاسترخاء وإراحة الجسد والعقل.","address":"Abu Baker Al Siddique Rd Deira Adjacent To Hamarai","city":"DEIRA","countryCode":"AE","postalCode":"16590","lat":25.268666,"lng":55.329745,"stars":5,"chain":"MARIO","giataCode":"15139","phone":"97142624444","email":"jwdubai.dining@marriotthotels.com","images":[{"url":"https://photos.hotelbeds.com/giata/bigger/06/064220/064220a_hb_a_002.jpg","category":"exterior","order":0},{"url":"https://photos.hotelbeds.com/giata/bigger/06/064220/064220a_hb_l_002.jpg","category":"lobby","order":1},{"url":"https://photos.hotelbeds.com/giata/bigger/06/064220/064220a_hb_l_001.jpg","category":"lobby","order":2},{"url":"https://photos.hotelbeds.com/giata/bigger/06/064220/064220a_hb_ro_001.jpg","roomCode":"DBT.DX","category":"room","order":3},{"url":"https://photos.hotelbeds.com/giata/bigger/06/064220/064220a_hb_ro_003.jpg","roomCode":"DBL.EJ","category":"room","order":4},{"url":"https://photos.hotelbeds.com/giata/bigger/06/064220/064220a_hb_p_004.jpg","category":"pool","order":5},{"url":"https://photos.hotelbeds.com/giata/bigger/06/064220/064220a_hb_r_012.jpg","category":"restaurant","order":6},{"url":"https://photos.hotelbeds.com/giata/bigge