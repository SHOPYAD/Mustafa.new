{"supplier":"hotelbeds","supplierHotelId":"988249","name":"Manors Hotel","description":"يقع فندق MANORS في مدينة إسطنبول، على بُعد 1. 3 كم من جامع سليمان القانوني، ويوفر إطلالات على المدينة. ويضم مكان الإقامة هذا مطعمًا وخدمة الغرف ومكتب استقبال يعمل على مدار الساعة، بالإضافة إلى خدمة الواي فاي المجانية في جميع أنحاء مكان الإقامة. ويوفر مكان الإقامة خدمة الكونسيرج ومكتبًا للجولات السياحية وخدمة تحويل العملات للضيوف. تحتوي غرف الفندق على تكييف هواء ومنطقة جلوس وتلفزيون بشاشة مسطحة مع قنوات فضائية وخزنة وحمام خاص مع دش ولوازم استحمام مجانية ومجفف شعر. وتضم جميع غرف فندق MANORS بياضات أسرّة ومناشف. يمكن للضيوف في مكان الإقامة الاستمتاع ببوفيه إفطار. يقع بازار التوابل على بُعد 1. 9 كم من فندق MANORS، بينما يقع الجامع الأزرق على بُعد 2. 6 كم من مكان الإقامة. ويعتبر مطار إسطنبول صبيحة غوكشين الدولي المطار الأقرب للفندق، حيث يقع على بُعد 38 كم.","address":"Kemalpaşa Mah.gençtürk, NO:3-5","city":"İSTANBUL","countryCode":"TR","postalCode":"34134","lat":41.0095122,"lng":28.9553325,"giataCode":"1366802","phone":"+902125203511","email":"manors@manorshotel.com","website":"www.manorshotel.com","images":[{"url":"https://photos.hotelbeds.com/giata/bigger/98/988249/988249a_hb_a_003.JPG","category":"exterior","order":0},{"url":"https://photos.hotelbeds.com/giata/bigger/98/988249/988249a_hb_a_001.JPG","category":"exterior","order":1},{"url":"https://photos.hotelbeds.com/giata/bigger/98/988249/988249a_hb_a_002.JPG","category":"exterior","order":2},{"url":"https://photos.hotelbeds.com/giata/bigger/98/988249/988249a_hb_l_001.JPG","category":"lobby","order":3},{"url":"https://photos.hotelbeds.com/giata/bigger/98/988249/988249a_hb_l_002.JPG","category":"lobby","order":4},{"url":"https://photos.hotelbeds.com/giata/bigger/98/988249/988249a_hb_ro_001.JPG","roomCode":"DBL.DX-KG","category":"room","order":5},{"url":"https://photos.hotelbeds.com/giata/bigger/98/988249/988249a_hb_ro_002.jpg","roomCode":"FAM.DX","category":"room","order":6},{"url":"https://photos.hotelbeds.com/giata/bigger/98/9882