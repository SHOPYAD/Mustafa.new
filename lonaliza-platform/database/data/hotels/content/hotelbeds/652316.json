{"supplier":"hotelbeds","supplierHotelId":"652316","name":"United Residence [SHA Plus-Certified]","description":"تقع يونايتد ريزيدنس في أحد أكثر أحياء المدينة عصريةً، ويسهل الوصول منها إلى أشهر معالم بانكوك ووجهاتها التي يجب زيارتها. نحن في قلب المدينة حيث تزدهر الأعمال في الصباح وتضج بالحياة في الليل. تقع على بُعد خطوات قليلة فقط عدد لا يحصى من مراكز الأعمال والمطاعم والبارات والنوادي وغيرها من المجمعات الترفيهية. في يونايتد ريزيدنس، يمكن للمسافرين والمغتربين على حد سواء الاستمتاع بإقامات مريحة طويلة أو قصيرة الأجل مع خدمات حصرية ومجموعة واسعة من وسائل الراحة. تشمل بعض وسائل الراحة في الفندق خدمة الواي فاي وخدمات التنظيف الجاف وخدمة الغرف وخزائن ومصعد. لعشاق اللياقة البدنية، تتوفر صالة لياقة بدنية مفتوحة على مدار الساعة طوال أيام الأسبوع، وهناك أيضًا حديقة على السطح حيث يمكنك الاسترخاء والراحة بعد يوم طويل.","address":"414 Sukhumvit Soi 63 , Sukhumvit Rd","city":"Bangkok","countryCode":"TH","postalCode":"10110","lat":13.7362109,"lng":100.58835739999995,"stars":3,"giataCode":"490994","phone":"+6627115020","email":"INFO@UNITEDRESIDENCE.COM","website":"https://www.unitedresidence.com/","images":[{"url":"https://photos.hotelbeds.com/giata/bigger/65/652316/652316a_hb_a_028.jpg","category":"exterior","order":0},{"url":"https://photos.hotelbeds.com/giata/bigger/65/652316/652316a_hb_a_029.jpg","category":"exterior","order":1},{"url":"https://photos.hotelbeds.com/giata/bigger/65/652316/652316a_hb_a_005.jpg","category":"exterior","order":2},{"url":"https://photos.hotelbeds.com/giata/bigger/65/652316/652316a_hb_a_025.jpg","category":"exterior","order":3},{"url":"https://photos.hotelbeds.com/giata/bigger/65/652316/652316a_hb_a_016.jpg","category":"exterior","order":4},{"url":"https://photos.hotelbeds.com/giata/bigger/65/652316/652316a_hb_a_021.jpg","category":"exterior","order":5},{"url":"https://photos.hotelbeds.com/giata/bigger/65/652316/652316a_hb_a_024.jpg","category":"exterior","order":6},{"url":"https://photos.hotelbeds.com/giata/bigger/65/652316/652316a_hb_a_002.jpg","c