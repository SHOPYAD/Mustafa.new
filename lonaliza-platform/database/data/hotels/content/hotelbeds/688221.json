house.com","images":[{"url":"https://photos.hotelbeds.com/giata/bigger/68/688221/688221a_hb_a_001.jpg","category":"exterior","order":0},{"url":"https://photos.hotelbeds.com/giata/bigger/68/688221/688221a_hb_a_015.jpg","category":"exterior","order":1},{"url":"https://photos.hotelbeds.com/giata/bigger/68/688221/688221a_hb_a_003.jpg","category":"exterior","order":2},{"url":"https://photos.hotelbeds.com/giata/bigger/68/688221/688221a_hb_a_006.jpg","category":"exterior","order":3},{"url":"https://photos.hotelbeds.com/giata/bigger/68/688221/688221a_hb_a_020.jpg","category":"exterior","order":4},{"url":"https://photos.hotelbeds.com/giata/bigger/68/688221/688221a_hb_a_021.jpg","category":"exterior","order":5},{"url":"https://photos.hotelbeds.com/giata/bigger/68/688221/688221a_hb_a_022.jpg","category":"exterior","order":6},{"url":"https://photos.hotelbeds.com/giata/bigger/68/688221/688221a_hb_a_023.jpg","category":"exterior","order":7},{"url":"https://photos.hotelbeds.com/giata/bigger/68/688221/688221a_hb_a_004.jpg","category":"exterior","order":8},{"url":"https://photos.hotelbeds.com/giata/bigger/68/688221/688221a_hb_a_016.jpg","category":"exterior","order":9},{"url":"https://photos.hotelbeds.com/giata/bigger/68/688221/688221a_hb_a_005.jpg","category":"exterior","order":10},{"url":"https://photos.hotelbeds.com/giata/bigger/68/688221/688221a_hb_a_017.jpg","category":"exterior","order":11},{"url":"https://photos.hotelbeds.com/giata/bigger/68/688221/688221a_hb_a_007.jpg","category":"exterior","order":12},{"url":"https://photos.hotelbeds.com/giata/bigger/68/688221/688221a_hb_a_019.jpg","category":"exterior","order":13},{"url":"https://photos.hotelbeds.com/giata/bigger/68/688221/688221a_hb_l_005.jpg","category":"lobby","order":14},{"url":"https://photos.hotelbeds.com/giata/bigger/68/688221/688221a_hb_l_004.jpg","category":"lobby","order":15},{"url":"https://photos.hotelbeds.com/giata/bigger/68/688221/688221a_hb_l_006.jpg","category":"lobby","order":16},{"url":"https://photos.hot