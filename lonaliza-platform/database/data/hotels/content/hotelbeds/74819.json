{"supplier":"hotelbeds","supplierHotelId":"74819","name":"Pavillon Saint Augustin","description":"يتمتع هذا السكن الفندقي بموقع مثالي في قلب باريس، حيث يقع على بُعد أقل من 3 كم من قوس النصر و4 كم من برج إيفل، وهو يُعدّ المكان الأمثل لمن يبحثون عن فندق مريح وعملي بالقرب من مناطق الجذب الرئيسية في المدينة. يقع الفندق في منطقة مليئة بالمحلات التجارية والمطاعم والمقاهي، فضلاً عن خيارات مُتنوّعة من وسائل النقل العام. كما يبعُد مطارا شارل ديغول وأورلي حوالي 30 دقيقة بالسيارة. يمكن للضيوف الاختيار من بين الغرف الكلاسيكية والحديثة، وجميعها مُصمّمة ومُزينة بشكلٍ جميل لتوفير إقامة مُمتعة. تحتوي الغرف على ميني بار وخدمة الواي فاي المجانية لأولئك الذين يحتاجون للبقاء على اتصال دائم. في كل صباح، يُمكنك الاستمتاع بوجبة فطور لذيذة في مطعم الفندق وتذوّق المأكولات الفرنسية على التراس المفتوح في فصل الصيف. كما تتوفر أيضًا مرافق للاجتماعات للمسافرين بغرض العمل.","address":"Rue De La Pepiniere, 16","city":"PARIS","countryCode":"FR","postalCode":"75008","lat":48.87513,"lng":2.32151,"stars":3,"giataCode":"15683","phone":"0033153049696","email":"saintaugustin@leshotelsdeparis.com","website":"www.leshotelsdeparis.com","images":[{"url":"https://photos.hotelbeds.com/giata/bigger/07/074819/074819a_hb_w_001.jpg","category":"room","order":0}],"facilities":[{"group":"طرق الدفع","name":"اميركان اكسبريس","code":"30-10"},{"group":"طرق الدفع","name":"JCB","code":"30-30"},{"group":"طرق الدفع","name":"Diners Club","code":"30-40"},{"group":"طرق الدفع","name":"ماستر كارد","code":"30-50"},{"group":"طرق الدفع","name":"فيزا كارد","code":"30-60"},{"group":"المسافات (بالأمتار)","name":"مركز المدينة: 1000 m","code":"40-10"},{"group":"المسافات (بالأمتار)","name":"محطة الحافلات / القطارات: 200 m","code":"40-145"},{"group":"المسافات (بالأمتار)","name":"مطار: 2000 m","code":"40-80"},{"group":"مرافق","name":"استقبال 24 ساعة","code":"70-30"},{"group":"مرافق","name":"إنترنت","code":"70-250","fee":true},{"group":"مرافق","name":"خدمة الغرف","code":"70-270","fee":true},{"group":"مرافق","name":"خدمة غسيل الملابس","code"