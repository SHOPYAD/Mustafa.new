{"supplier":"hotelbeds","supplierHotelId":"221476","name":"Sakarya Balturk Hotel","description":"يتميز هذا الفندق بموقع مثالي في قلب مدينة ساكاريا، حيث يقع بالقرب من المرافق المحلية وشبكة النقل العام. كما توجد العديد من المعالم السياحية الرائعة على مقربة منه، وتسهل الوصول إلى محطة الحافلات من الفندق. يُعد هذا الفندق خيارًا مثاليًا للمسافرين بغرض العمل أو الترفيه، وسيترك بلا شك انطباعًا مميزًا لدى النزلاء. تتميز غرف الضيوف بتصميمها الجميل، بألوان هادئة وأجواء من الراحة والسكينة. يضم الفندق قاعة اجتماعات مجهزة بالكامل لتلبية احتياجات رجال الأعمال، بالإضافة إلى ردهة للاسترخاء والاستجمام، ومقهى على التراس، ومطعم، وبار.","address":"Ankara Caddesi, 39","city":"SAKARYA","countryCode":"TR","lat":40.779164,"lng":30.404019,"stars":4,"giataCode":"277423","phone":"00902642733920","email":"info@hotelbalturk.com","website":"www.balturkotel.com","images":[{"url":"https://photos.hotelbeds.com/giata/bigger/22/221476/221476a_hb_a_008.jpg","category":"exterior","order":0},{"url":"https://photos.hotelbeds.com/giata/bigger/22/221476/221476a_hb_a_009.jpg","category":"exterior","order":1},{"url":"https://photos.hotelbeds.com/giata/bigger/22/221476/221476a_hb_a_010.jpg","category":"exterior","order":2},{"url":"https://photos.hotelbeds.com/giata/bigger/22/221476/221476a_hb_a_011.jpg","category":"exterior","order":3},{"url":"https://photos.hotelbeds.com/giata/bigger/22/221476/221476a_hb_a_012.jpg","category":"exterior","order":4},{"url":"https://photos.hotelbeds.com/giata/bigger/22/221476/221476a_hb_a_013.jpg","category":"exterior","order":5},{"url":"https://photos.hotelbeds.com/giata/bigger/22/221476/221476a_hb_l_002.jpg","category":"lobby","order":6},{"url":"https://photos.hotelbeds.com/giata/bigger/22/221476/221476a_hb_l_001.jpg","category":"lobby","order":7},{"url":"https://photos.hotelbeds.com/giata/bigger/22/221476/221476a_hb_w_001.jpg","category":"room","order":8},{"url":"https://photos.hotelbeds.com/giata/bigger/22/221476/221476a_hb_w_002.jpg","category":"room","order":9},{"url":"htt