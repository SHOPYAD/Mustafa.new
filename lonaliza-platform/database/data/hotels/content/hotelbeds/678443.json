{"supplier":"hotelbeds","supplierHotelId":"678443","name":"Four Doors Hotel","description":"استمتع بالإطلالات من التراس، واستفد من وسائل الراحة المتوفرة مثل خدمة الواي فاي المجانية وخدمات الكونسيرج. تمتع بتناول وجبة في المطعم أو تناول وجبة خفيفة في المقهى. يوفر الفندق أيضًا خدمة الغرف (خلال ساعات محدودة). يتم تقديم بوفيه إفطار مجاني يوميًا من الساعة 8:00 صباحًا إلى 10:00 صباحًا. تشمل وسائل الراحة المميزة خدمة التنظيف الجاف/الغسيل، ومكتب استقبال يعمل على مدار 24 ساعة، وخدمة تخزين الأمتعة. يتم توفير خدمة النقل من وإلى المطار مقابل تكلفة إضافية (متوفرة على مدار 24 ساعة). اشعر وكأنك في منزلك في إحدى غرف النزلاء الـ 18 التي تحتوي على ميني بار وتلفزيون إل سي دي. ابقَ على اتصال دائمًا بفضل خدمة الواي فاي المجانية، واستمتع بمشاهدة البرامج الفضائية المتاحة. تضم الحمامات الخاصة تجهيزات دش ولوازم استحمام مجانية ومجففات شعر. تشتمل وسائل الراحة على هواتف وخزائن مناسبة لأجهزة الكمبيوتر المحمول ومكاتب. يتم عرض المسافات لأقرب 0. 1 ميل وكيلومتر. ميدان السلطان أحمد - 0. 3 كم / 0. 2 ميل - متحف الفنون التركية والإسلامية - 0. 3 كم / 0. 2 ميل - آيا صوفيا الصغرى - 0. 4 كم / 0. 2 ميل - حمام جيمبرليتاس - 0. 4 كم / 0. 3 ميل - الجامع الأزرق - 0. 6 كم / 0. 4 ميل - البازار الكبير - 0. 7 كم / 0. 4 ميل - صهريج البازيليك - 0. 8 كم / 0. 5 ميل - آيا صوفيا - 0. 9 كم / 0.","address":"Katip Sinan Cami Sok No 34 Sultanahmet","city":"ISTANBUL","countryCode":"TR","postalCode":"34400","lat":41.005453203968166,"lng":28.971851586777685,"stars":3,"giataCode":"437798","phone":"+902125167374","images":[{"url":"https://photos.hotelbeds.com/giata/bigger/67/678443/678443a_hb_a_001.jpg","category":"exterior","order":0},{"url":"https://photos.hotelbeds.com/giata/bigger/67/678443/678443a_hb_a_002.jpg","category":"exterior","order":1},{"url":"https://photos.hotelbeds.com/giata/bigger/67/678443/678443a_hb_a_003_20260804_164025.jpg","category":"exterior","order":2},{"url":"https://photos.hotelbeds.com/giata/bigger/67/678443/678443a_hb_a_004_20260804_164146.jpg","category":"exterior","order":3},{"url":"https://photos.hot