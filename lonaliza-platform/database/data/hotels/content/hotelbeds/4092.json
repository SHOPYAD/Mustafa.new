{"supplier":"hotelbeds","supplierHotelId":"4092","name":"Leonardo Hotel Las Ramblas","description":"يتمتع هذا الفندق الكلاسيكي بموقع رائع في قلب برشلونة، على بُعد خطوات من سوق لا بوكيريا الشهير وثلاث دقائق سيرًا على الأقدام من أشهر ممشى في المدينة، لا رامبلا. تقع محطة مترو ليسيو على بُعد 250 مترًا، مما يُتيح سهولة الوصول إلى أجزاء أخرى من المدينة مثل مونتجويك وحديقة بارك جويل الرائعة التي صممها غاودي. يقع الفندق في مبنى يعود تاريخه إلى عام 1866، ويجمع هذا الفندق العائلي المريح بين التصميم الداخلي العصري والتفاصيل التاريخية الجميلة. ويضم تراسًا على السطح مع مسبح موسمي، يتمتع بإطلالات رائعة على المدينة ومكتب استقبال يعمل على مدار 24 ساعة لمزيد من الراحة. يمكن للضيوف أيضًا استخدام خدمة الإنترنت اللاسلكي (واي فاي) المُقدمة في جميع أنحاء الفندق والاستيقاظ على وجبة إفطار يومية مع خيارات ساخنة وباردة.","address":"Junta De Comerç, 8-12","city":"BARCELONA","countryCode":"ES","postalCode":"08001","lat":41.38012989364813,"lng":2.1710946410894394,"stars":3,"chain":"LEOES","giataCode":"47262","phone":"+34933188970","email":"info.ramblas@leonardo-hotels.com","website":"www.leonardo-hotels.com","images":[{"url":"https://photos.hotelbeds.com/giata/bigger/00/004092/004092a_hb_a_027.jpg","category":"exterior","order":0},{"url":"https://photos.hotelbeds.com/giata/bigger/00/004092/004092a_hb_a_028.jpg","category":"exterior","order":1},{"url":"https://photos.hotelbeds.com/giata/bigger/00/004092/004092a_hb_l_023.jpg","category":"lobby","order":2},{"url":"https://photos.hotelbeds.com/giata/bigger/00/004092/004092a_hb_l_024.jpg","category":"lobby","order":3},{"url":"https://photos.hotelbeds.com/giata/bigger/00/004092/004092a_hb_l_025.jpg","category":"lobby","order":4},{"url":"https://photos.hotelbeds.com/giata/bigger/00/004092/004092a_hb_w_019_20250505_085011.jpg","category":"room","order":5},{"url":"https://photos.hotelbeds.com/giata/bigger/00/004092/004092a_hb_w_020_20250807_152227.jpg","category":"room","order":6},{"url":"https://photos.hotelbeds.com/giata/bigger/00/004092/004092a_hb_ro