{"supplier":"hotelbeds","supplierHotelId":"914462","name":"Pyramids Oasis Hotel","description":"عندما تقيم في Pyramids Chill Out Hotel في الجيزة، ستكون في منطقة تاريخية، على بُعد 15 دقيقة فقط بالسيارة من منطقة أهرامات الجيزة وأبو الهول. يقع هذا الفندق على بُعد 17. 1 كم من المتحف المصري و3. 8 كم من هضبة الجيزة. استمتع بوسائل الراحة المتاحة مثل خدمة إنترنت لاسلكي مجانية ومتاجر للهدايا/أكشاك جرائد ومدفأة في الردهة. تشمل وسائل الراحة المتوفرة مكتب استقبال يعمل على مدار 24 ساعة وصندوق ودائع آمن في مكتب الاستقبال ومصعد. تتوفر خدمة نقل مكوكية مجانية من المطار إلى الفندق (متوفرة على مدار 24 ساعة). يتم تقديم فطور كونتيننتال مجاني يوميًا من الساعة 7:00 صباحًا إلى 10:00 صباحًا. اشعر وكأنك في بيتك في إحدى الغرف الـ 40 المكيفة التي تحتوي على مدافئ وأجهزة تلفزيون إل سي دي. تحتوي غرفتك على سرير من إسفنج الذاكرة. ابقَ على اتصال دائمًا بفضل خدمة الإنترنت اللاسلكي المجانية، واستمتع ببرامج القنوات الفضائية المتاحة للترفيه. تشتمل وسائل الراحة على مكاتب وميني بار، وتتوفر خدمة تنظيف الغرف عند الطلب.","address":"Al mansouria","city":"GIZA","countryCode":"EG","postalCode":"12511","lat":29.958088,"lng":31.151951,"stars":2,"giataCode":"1007509","phone":"+201288000083","images":[{"url":"https://photos.hotelbeds.com/giata/bigger/91/914462/914462a_hb_a_001.jpg?20220322125130?20250528215454","category":"exterior","order":0},{"url":"https://photos.hotelbeds.com/giata/bigger/91/914462/914462a_hb_a_002.jpg?20220322125146?20250528215454","category":"exterior","order":1},{"url":"https://photos.hotelbeds.com/giata/bigger/91/914462/914462a_hb_a_003.jpg?20220718090622?20250528215454","category":"exterior","order":2},{"url":"https://photos.hotelbeds.com/giata/bigger/91/914462/914462a_hb_a_005.jpg?20220718090633?20250528215453","category":"exterior","order":3},{"url":"https://photos.hotelbeds.com/giata/bigger/91/914462/914462a_hb_a_006.jpg?20220718090646?20250528215453","category":"exterior","order":4},{"url":"https://photos.hotelbeds.com/giata/bigger/91/914462/914462a_hb_a_007.jpg?20220718090653?20250528