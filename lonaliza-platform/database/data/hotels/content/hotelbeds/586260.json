{"supplier":"hotelbeds","supplierHotelId":"586260","name":"فندق الماسة","description":"إن موقع فندق وسبا الماسة ممتاز للمسافرين إلى المدينة من أجل العمل أو الاسترخاء. الفندق يقدم خدمة مستوى عالي ومرافق تناسب حاجات المسافرين الفردية. ستجد في الفندق المرافق والخدمات التالية: خدمة الغرف على مدار الساعة, واي فاي مجاني في جميع الغرف, أمن على مدار 24 ساعة, خدمة التنظيف يوميًا, خدمة سيارات الأجرة تحتوي بعض الغرف المصممة خصيصاً لراحتك على المرافق التالية: تلفزيون بشاشة مسطحة, هاتف في الحمام, مرآة, شباشب, مناشف. ينظم الفندق العديد من النشاطات الترفيهية. طاقم عمله اللطيف، مرافقه الرائعة، وقربه من أهم معالم المدينة هي ثلاثة من الأسباب التي تجعل الإقامة في فندق وسبا الماسة خياراً ممتازاً.","address":"شارع عبد العزيز الشناوى خلف المنصة - مدينة نصر","city":"القاهرة","countryCode":"EG","postalCode":"11759","lat":30.06127803,"lng":31.3157773,"stars":5,"giataCode":"407215","phone":"+20224023730","email":"reservation@almasahotel-nasrcity.com","website":"www.almasa-hotels.com","images":[{"url":"https://photos.hotelbeds.com/giata/bigger/58/586260/586260a_hb_a_006.JPG","category":"exterior","order":0},{"url":"https://photos.hotelbeds.com/giata/bigger/58/586260/586260a_hb_a_007.jpg","category":"exterior","order":1},{"url":"https://photos.hotelbeds.com/giata/bigger/58/586260/586260a_hb_a_001.JPG","category":"exterior","order":2},{"url":"https://photos.hotelbeds.com/giata/bigger/58/586260/586260a_hb_a_005_20250701_074455.jpg","category":"exterior","order":3},{"url":"https://photos.hotelbeds.com/giata/bigger/58/586260/586260a_hb_a_003.jpg","category":"exterior","order":4},{"url":"https://photos.hotelbeds.com/giata/bigger/58/586260/586260a_hb_a_002.jpg","category":"exterior","order":5},{"url":"https://photos.hotelbeds.com/giata/bigger/58/586260/586260a_hb_a_008_20250701_074612.jpg","category":"exterior","order":6},{"url":"https://photos.hotelbeds.com/giata/bigger/58/586260/586260a_hb_a_009_20250701_074613.jpg","category":"exterior","order":7},{"url":"https://photos.hotelbeds.com/giata/bigger