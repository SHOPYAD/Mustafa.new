{"supplier":"hotelbeds","supplierHotelId":"719090","name":"Disney's Newport Bay Club","description":"يقع هذا الفندق ذو الـ 4 نجوم على ضفاف بحيرة ديزني، وهو مصمم على طراز قصور نيو إنجلاند الساحلية في عشرينيات القرن الماضي. يتميز الفندق بديكور بحري في جميع أنحاء غرفه ومساحاته المشتركة، مع منارة خاصة به. يمكن للضيوف الاستمتاع بإمكانية الوصول إلى مسبح داخلي وخارجي مُدفأ، وساونا، ومركز للياقة البدنية. تشمل خيارات تناول الطعام بوفيه كيب كود الدولي، ومطعم يخت كلوب الذي يقدم أطباقًا من البر والبحر، وبار كابتنز كوارترز. جميع الغرف مكيفة وتحتوي على خدمة الواي فاي المجانية وجهاز تلفزيون بشاشة مسطحة مع قنوات ديزني. تشمل أنواع الغرف غرفًا فاخرة، بعضها مزود بتراس أو إطلالة على البحيرة، وغرف كومباس كلوب المتميزة. يوفر الفندق فرص لقاء شخصيات ديزني، ويقع على بُعد 15 دقيقة سيرًا على الأقدام من منتزهات ديزني لاند® باريس، كما تتوفر خدمة نقل مجانية.","address":"Avenue Robert Schuman","city":"PARIS","countryCode":"FR","postalCode":"77700","lat":48.865269,"lng":2.789285,"stars":4,"chain":"Disne","giataCode":"31281","phone":"+33160455500","images":[{"url":"https://photos.hotelbeds.com/giata/bigger/71/719090/719090a_hb_a_001.jpg","category":"exterior","order":0},{"url":"https://photos.hotelbeds.com/giata/bigger/71/719090/719090a_hb_a_002.jpg","category":"exterior","order":1},{"url":"https://photos.hotelbeds.com/giata/bigger/71/719090/719090a_hb_l_001.jpg","category":"lobby","order":2},{"url":"https://photos.hotelbeds.com/giata/bigger/71/719090/719090a_hb_w_001.jpg","category":"room","order":3},{"url":"https://photos.hotelbeds.com/giata/bigger/71/719090/719090a_hb_w_002.jpg","category":"room","order":4},{"url":"https://photos.hotelbeds.com/giata/bigger/71/719090/719090a_hb_w_003.jpg","category":"room","order":5},{"url":"https://photos.hotelbeds.com/giata/bigger/71/719090/719090a_hb_p_001.jpg","category":"pool","order":6},{"url":"https://photos.hotelbeds.com/giata/bigger/71/719090/719090a_hb_p_002.jpg","category":"pool","order":7},{"url":"https://photos.hotelbeds.com/giata/bigger/71/719090/71