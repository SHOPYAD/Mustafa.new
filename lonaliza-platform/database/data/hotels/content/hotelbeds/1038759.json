{"supplier":"hotelbeds","supplierHotelId":"1038759","name":"Nemes Pyramids View Inn","description":"الإقامة في نمس بيراميدز فيو إن في الجيزة تضعك على بُعد 4 دقيقة/دقائق سيرا من مجمع أهرامات الجيزة و7 دقيقة/دقائق مشيا على الأقدام من تمثال أبو الهول بالجيزة، كما أنك ستكون في منشأة متصلة بمركز تسوق. الإقامة في هذا الفندق تضعك على بُعد ٥٫٥ كم من المتحف المصري الكبير و١٫٢ كم من هرم خوفو. تمتع بوسائل الراحة المتاحة في هذه المنشأة، ومنها اتصال لاسلكي مجاني بالإنترنت و المساعدة في تنظيم الجولات وحجز التذاكر ومعلومات عن جولات بالدرّاجات. في هذا الفندق، ستجد مزايا منها مكان لتخزين الدرّاجات وخدمات لتصليح الدرّاجات. تضم وسائل الرائحة المميزة خدمة الغسيل/التنظيف الجاف ومكتب استقبال مفتوح 24 ساعة وخدمة تخزين الأمتعة. يتم توفير حافلة توصيل من المطار إلى الفندق مجانا (متوفرة على مدار 24 ساعة). استمتع بوجبة في مطعم منشأة فندقية أو بتناول المأكولات الخفيفة في الكافيتيريا. التقِ بالنزلاء الآخرين وتناول الطعام في حفل استقبال ترحيبي يعقد يومياً. أنهِ يومك بتناول مشروب مُنعش في البار/الاستراحة. يتم تقديم فطور أوروبي مجانًا يوميًا من 7:00 صباحًا إلى 10:30 صباحًا. اشعر وكأنك في بيتك بالإقامة في واحدة من 11 غرفة ضيافة.","address":"Abo El Hol, El Syahy, Nazlet Al Samman, Al Haram, 7","city":"29.9753201,31.1389744","countryCode":"EG","postalCode":"12512","lat":29.9746666,"lng":31.1411582,"giataCode":"1512348","phone":"+201070030783","email":"nemespyramidsviewinn@gmail.com","images":[{"url":"https://photos.hotelbeds.com/giata/bigger/10/1038759/1038759a_hb_a_002_20250401_074142.JPG","category":"exterior","order":0},{"url":"https://photos.hotelbeds.com/giata/bigger/10/1038759/1038759a_hb_a_001_20250401_074141.JPG","category":"exterior","order":1},{"url":"https://photos.hotelbeds.com/giata/bigger/10/1038759/1038759a_hb_a_003_20260310_154751.jpg","category":"exterior","order":2},{"url":"https://photos.hotelbeds.com/giata/bigger/10/1038759/1038759a_hb_a_004_20260310_154753.jpg","category":"exterior","order":3},{"url":"https://photos.hotelbeds.com/giata/bigger/10/1038759/1038759a_hb_a_005_20260310_