{"supplier":"hotelbeds","supplierHotelId":"331931","name":"Absolute Hotel Paris","description":"يقع هذا الفندق ذو المفهوم العصري ذو النجمتين على حافة قناة سان مارتان العصرية، على بُعد 300 متر من ساحة الجمهورية. يتميز الفندق بتصميمات داخلية من قِبل مصمم جرافيك بأسلوب فن الشارع، ويوفر خدمة مكتب استقبال على مدار الساعة. جميع مناطق الفندق مخصصة لغير المدخنين ومخدومة بمصعد. تتراوح خيارات الإقامة من غرف مفردة ومزدوجة وعائلية إلى أسِرّة في مهجع مشترك. جميع الغرف مجهزة بخدمة الواي فاي المجانية، وبعضها يوفر إطلالة على القناة. تتوفر وجبة إفطار كونتيننتال للضيوف كل صباح. يقع مركز بومبيدو على بُعد 1. 5 كم من الفندق. يُرجى ملاحظة أن الفندق لا يحتوي على غرف مُكيّفة للضيوف ذوي الحركة المحدودة.","address":"Rue de la Fontaine au Roi, 1","city":"PARIS","countryCode":"FR","postalCode":"75011","lat":48.868833,"lng":2.368128,"stars":1,"giataCode":"131101","phone":"+33953774418","email":"bonjour@absolutehotelparis.com","website":"http://www.absolute-paris.com/","images":[{"url":"https://photos.hotelbeds.com/giata/bigger/33/331931/331931a_hb_a_034.jpg","category":"exterior","order":0},{"url":"https://photos.hotelbeds.com/giata/bigger/33/331931/331931a_hb_l_003.JPG","category":"lobby","order":1},{"url":"https://photos.hotelbeds.com/giata/bigger/33/331931/331931a_hb_l_001.jpg","category":"lobby","order":2},{"url":"https://photos.hotelbeds.com/giata/bigger/33/331931/331931a_hb_l_002.jpg","category":"lobby","order":3},{"url":"https://photos.hotelbeds.com/giata/bigger/33/331931/331931a_hb_w_001.jpg","category":"room","order":4},{"url":"https://photos.hotelbeds.com/giata/bigger/33/331931/331931a_hb_w_004.jpg","category":"room","order":5},{"url":"https://photos.hotelbeds.com/giata/bigger/33/331931/331931a_hb_w_002.jpg","category":"room","order":6},{"url":"https://photos.hotelbeds.com/giata/bigger/33/331931/331931a_hb_w_003.jpg","category":"room","order":7},{"url":"https://photos.hotelbeds.com/giata/bigger/33/331931/331931a_hb_ro_027.JPG","roomCode":"BED.1B","category":"room","order":8},{"url":"h