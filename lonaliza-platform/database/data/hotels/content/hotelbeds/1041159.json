{"supplier":"hotelbeds","supplierHotelId":"1041159","name":"Le Lampika Hotel","description":"يقع فندق Le Lampika Hôtel في الدائرة الرابعة عشرة النابضة بالحياة في باريس، ويتيح الوصول بسهولة إلى مناطق الجذب الرئيسية. يقع الفندق على بُعد خطوات من سراديب الموتى في باريس، ومسافة قصيرة بالسيارة من حدائق لوكسمبورغ، ويوفر أماكن إقامة مريحة مع وسائل راحة عصرية. تتميز كل غرفة من غرف الضيوف الأربعين المُفروشة بشكل فردي بوجود ماكينة إسبريسو وتلفزيون ذكي وخدمة الواي فاي المجانية. يمكن للضيوف أيضًا الاستمتاع ببوفيه إفطار يوميًا مقابل رسوم. تشمل مناطق الجذب السياحي القريبة برج مونبارناس وجامعة السوربون وشارع موفتارد وLe Bon Marche وبانثيون وغيرها. أقرب المطارات هي مطار باريس أورلي (ORY) ومطار باريس شارل ديغول (CDG).","address":"Place Denfert-rochereau, 28 7","city":"Paris","countryCode":"FR","postalCode":"75014","lat":48.8337407,"lng":2.3311859,"stars":4,"giataCode":"411711","phone":"+33186544141","email":"contact@lampikahotelparis.com","website":"28 Place Denfert Rochereau","images":[{"url":"https://photos.hotelbeds.com/giata/bigger/10/1041159/1041159a_hb_a_001.jpg?20240903222415?20250502142610","category":"exterior","order":0},{"url":"https://photos.hotelbeds.com/giata/bigger/10/1041159/1041159a_hb_a_005.jpg?20241031001821?20250502142611","category":"exterior","order":1},{"url":"https://photos.hotelbeds.com/giata/bigger/10/1041159/1041159a_hb_a_006.jpg?20241229141638?20250502142610","category":"exterior","order":2},{"url":"https://photos.hotelbeds.com/giata/bigger/10/1041159/1041159a_hb_a_007_20251225_182101.jpg","category":"exterior","order":3},{"url":"https://photos.hotelbeds.com/giata/bigger/10/1041159/1041159a_hb_a_008_20251225_182103.jpg","category":"exterior","order":4},{"url":"https://photos.hotelbeds.com/giata/bigger/10/1041159/1041159a_hb_l_001.jpg?20240903222353?20250502142610","category":"lobby","order":5},{"url":"https://photos.hotelbeds.com/giata/bigger/10/1041159/1041159a_hb_l_002.jpg?20240903222354?20250502142610","category":"lobby","order":6},{"url":"https://phot