{"supplier":"hotelbeds","supplierHotelId":"165388","name":"Sorriso","description":"يقع هذا الفندق العصري الراقي في حي لالي بإسطنبول، على بُعد دقائق سيرًا على الأقدام من محطة مترو أكساراي، وعلى بُعد 1. 8 كم فقط من مناطق الجذب السياحي الرائعة في حي السلطان أحمد. ويمكن للضيوف في السلطان أحمد الاستمتاع بتجربة تسوق فريدة في السوق الكبير، أو الاستمتاع بمشاهدة الجامع الأزرق وقصر توبكابي وآيا صوفيا. يُعد هذا الفندق الساحر الخيار الأمثل للمسافرين بغرض العمل أو الترفيه على حد سواء نظرًا لموقعه الممتاز وخدماته التي لا تشوبها شائبة ومرافقه الاستثنائية. سيُنبهر الضيوف بالأجواء الهادئة للغرف المُزينة بشكل جميل والمجهزة بوسائل الراحة العصرية. يوفر الفندق مجموعة مختارة من مرافق الترفيه الاستثنائية لتجربة استرخاء لا مثيل لها.","address":"Ordu Caddesi No.60 Laleli Fatih, 65","city":"ISTANBUL","countryCode":"TR","postalCode":"34134","lat":41.009729,"lng":28.954909,"stars":4,"giataCode":"259575","phone":"+902125267000","email":"reservation@sorrisohotel.com","website":"www.sorrisohotel.com","images":[{"url":"https://photos.hotelbeds.com/giata/bigger/16/165388/165388a_hb_a_003.jpg","category":"exterior","order":0},{"url":"https://photos.hotelbeds.com/giata/bigger/16/165388/165388a_hb_a_006.jpg","category":"exterior","order":1},{"url":"https://photos.hotelbeds.com/giata/bigger/16/165388/165388a_hb_a_004.jpg","category":"exterior","order":2},{"url":"https://photos.hotelbeds.com/giata/bigger/16/165388/165388a_hb_l_007.jpg","category":"lobby","order":3},{"url":"https://photos.hotelbeds.com/giata/bigger/16/165388/165388a_hb_l_008.jpg","category":"lobby","order":4},{"url":"https://photos.hotelbeds.com/giata/bigger/16/165388/165388a_hb_w_012.jpg","category":"room","order":5},{"url":"https://photos.hotelbeds.com/giata/bigger/16/165388/165388a_hb_w_003.jpg","category":"room","order":6},{"url":"https://photos.hotelbeds.com/giata/bigger/16/165388/165388a_hb_w_006.jpg","category":"room","order":7},{"url":"https://photos.hotelbeds.com/giata/bigger/16/165388/165388a_hb_w_014.jpg","category":"room","or