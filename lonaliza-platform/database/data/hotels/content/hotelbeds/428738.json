{"supplier":"hotelbeds","supplierHotelId":"428738","name":"Pera Parma Hotel","description":"يقع فندق Pera Parma على بُعد ٥٥٠ مترًا فقط من وسط المدينة، مما يُتيح لك سهولة الوصول إلى مناطق الجذب المحلية ووسائل المواصلات. يوفر هذا الفندق الذي يحتوي على ٢٥ وحدة سكنية خدمة الواي فاي في جميع المناطق العامة وغرف النزلاء. يتوفر مكتب استقبال يعمل على مدار ٢٤ ساعة لتلبية احتياجات النزلاء، وجميع الغرف مجهزة لذوي الاحتياجات الخاصة. كما يوفر الفندق خدمة النقل من وإلى المطار، على الرغم من أن المطار يبعُد ١٥٠٠٠ كم. يمكن للنزلاء الاستمتاع بتناول الطعام في مرافق الفندق للحصول على تجربة طهي مريحة. سيُقدّر المسافرون بغرض العمل المساحات مُتعددة الاستخدامات للاجتماعات والمؤتمرات في الفندق.","address":"asmali mescit mh.mesrutiyet cd.no:7","city":"BEYOGLU","countryCode":"TR","postalCode":"34430","lat":41.033776,"lng":28.976908,"giataCode":"516518","phone":"+902122452222","email":"info@hotelperaparma.com","website":"www.hotelperaparma.com","images":[{"url":"https://photos.hotelbeds.com/giata/bigger/42/428738/428738a_hb_a_001.jpg","category":"exterior","order":0},{"url":"https://photos.hotelbeds.com/giata/bigger/42/428738/428738a_hb_a_002.jpg","category":"exterior","order":1},{"url":"https://photos.hotelbeds.com/giata/bigger/42/428738/428738a_hb_a_003.jpg","category":"exterior","order":2},{"url":"https://photos.hotelbeds.com/giata/bigger/42/428738/428738a_hb_l_001.jpg","category":"lobby","order":3},{"url":"https://photos.hotelbeds.com/giata/bigger/42/428738/428738a_hb_l_002.jpg","category":"lobby","order":4},{"url":"https://photos.hotelbeds.com/giata/bigger/42/428738/428738a_hb_l_003.jpg","category":"lobby","order":5},{"url":"https://photos.hotelbeds.com/giata/bigger/42/428738/428738a_hb_w_004.jpg","category":"room","order":6},{"url":"https://photos.hotelbeds.com/giata/bigger/42/428738/428738a_hb_w_005.jpg","category":"room","order":7},{"url":"https://photos.hotelbeds.com/giata/bigger/42/428738/428738a_hb_w_006.jpg","category":"room","order":8},{"url":"https://photos.hotelbeds.com/giata/big