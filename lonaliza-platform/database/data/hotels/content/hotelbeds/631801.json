{"supplier":"hotelbeds","supplierHotelId":"631801","name":"Hotel Tranz","description":"يُعد فندق Tranz ذو الـ 4 نجوم خيارًا مثاليًا للباحثين عن الراحة والملاءمة سواءً كانوا في رحلة عمل أو عطلة في بانكوك. مع قائمة مُرضية من وسائل الراحة، سيجد النزلاء إقامتهم في مكان الإقامة مُريحة للغاية. تتضمن قائمة الأشياء التي يُمكن للضيوف الاستمتاع بها خدمة الواي فاي المجانية في جميع الغرف وخدمة الغرف على مدار الساعة، والأمن على مدار الساعة، ومتجرًا صغيرًا، وخدمة تنظيف الغرف يوميًا. تضمن غرف الضيوف المريحة نومًا هانئًا في الليل، وتتميز بعض الغرف بمرافق مثل مُنتجات التنظيف، والشاي المجاني، والمناشف، والنعال، ومرحاض إضافي. استمتع بمرافق الترفيه في مكان الإقامة، والتي تشمل غرفة يوغا ومركزًا للياقة البدنية ومنتجعًا صحيًا وخدمة التدليك. يُعد فندق Tranz خيارًا ممتازًا لاستكشاف بانكوك أو ببساطة للاسترخاء وتجديد النشاط.","address":"53 Phayathai Rd, Khwaeng Thanon Phayathai,Ratchath, 53","city":"Bangkok","countryCode":"TH","postalCode":"10400","lat":13.7570225,"lng":100.5344791,"stars":4,"giataCode":"859669","phone":"+6622456779","email":"RSVN@HOTELTRANZ.COM","website":"www.hoteltranz.com","images":[{"url":"https://photos.hotelbeds.com/giata/bigger/63/631801/631801a_hb_a_010.jpg","category":"exterior","order":0},{"url":"https://photos.hotelbeds.com/giata/bigger/63/631801/631801a_hb_a_001.jpg","category":"exterior","order":1},{"url":"https://photos.hotelbeds.com/giata/bigger/63/631801/631801a_hb_a_002.jpg","category":"exterior","order":2},{"url":"https://photos.hotelbeds.com/giata/bigger/63/631801/631801a_hb_a_003.jpg","category":"exterior","order":3},{"url":"https://photos.hotelbeds.com/giata/bigger/63/631801/631801a_hb_a_007.jpg","category":"exterior","order":4},{"url":"https://photos.hotelbeds.com/giata/bigger/63/631801/631801a_hb_a_004.jpg","category":"exterior","order":5},{"url":"https://photos.hotelbeds.com/giata/bigger/63/631801/631801a_hb_a_006.jpg","category":"exterior","order":6},{"url":"https://photos.hotelbeds.com/giata/bigger/63/631801/631801a_hb_a_008.jpg","category":"exterio