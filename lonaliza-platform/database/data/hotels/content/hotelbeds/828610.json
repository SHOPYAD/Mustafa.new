{"supplier":"hotelbeds","supplierHotelId":"828610","name":"Pearl Hotel","description":"يقع فندق Pearl Hotel في قلب القاهرة، على بُعد مسافة قصيرة بالسيارة من نهر النيل ومستشفى السلام الدولي. يوفر هذا الفندق ذو الـ 48 غرفة خدمة واي فاي مجانية وخدمات الاستقبال ومنطقة تلفزيون مشتركة. تتميز كل غرفة مكيفة الهواء بثلاجة وتلفزيون بشاشة مسطحة مع قنوات فضائية وحمام خاص مع دُش. استمتع بتناول وجبة في المطعم الموجود في الموقع، أو وجبات خفيفة في المقهى، أو خدمة الغرف على مدار 24 ساعة. يتم تقديم وجبة إفطار كونتيننتال مجانية يوميًا. تشمل وسائل الراحة الإضافية خدمات التنظيف الجاف/الغسيل ومكتب استقبال يعمل على مدار 24 ساعة وخدمة تخزين الأمتعة وخدمة نقل المطار (مقابل تكلفة إضافية). يقع مطار القاهرة الدولي (CAI) على بُعد 32 كم تقريبًا.","address":"32 Streets 7 Maadi Cross Streets 7 82","city":"CAIRO","countryCode":"EG","postalCode":"11431","lat":29.956772,"lng":31.259774,"stars":3,"giataCode":"262011","phone":"+20223585385","images":[{"url":"https://photos.hotelbeds.com/giata/bigger/82/828610/828610a_hb_a_001.jpg","category":"exterior","order":0},{"url":"https://photos.hotelbeds.com/giata/bigger/82/828610/828610a_hb_a_002.jpg","category":"exterior","order":1},{"url":"https://photos.hotelbeds.com/giata/bigger/82/828610/828610a_hb_a_003.jpg","category":"exterior","order":2},{"url":"https://photos.hotelbeds.com/giata/bigger/82/828610/828610a_hb_a_004.jpg","category":"exterior","order":3},{"url":"https://photos.hotelbeds.com/giata/bigger/82/828610/828610a_hb_a_005.jpg","category":"exterior","order":4},{"url":"https://photos.hotelbeds.com/giata/bigger/82/828610/828610a_hb_a_006.jpg","category":"exterior","order":5},{"url":"https://photos.hotelbeds.com/giata/bigger/82/828610/828610a_hb_a_007.jpg","category":"exterior","order":6},{"url":"https://photos.hotelbeds.com/giata/bigger/82/828610/828610a_hb_a_008.jpg","category":"exterior","order":7},{"url":"https://photos.hotelbeds.com/giata/bigger/82/828610/828610a_hb_l_001.jpg","category":"lobby","order":8},{"url":"https://photos.hotelbeds.com/gia