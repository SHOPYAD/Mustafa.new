        "properties": {
          "@type": {
            "type": "string",
            "example": "ChangePermitted"
          },
          "ProductRefs": {
            "type": "array",
            "description": "The productRefs this change or cancel applies to",
            "example": [
              "baloon",
              "food",
              "accesories"
            ],
            "items": {
              "type": "string"
            }
          },
          "SegmentSequence": {
            "type": "array",
            "description": "The SegmentSequence of the product this change or cancel applies to",
            "example": [
              34,
              56,
              678,
              2
            ],
            "items": {
              "type": "integer",
              "format": "int32"
            }
          }
        },
        "discriminator": {
          "propertyName": "@type"
        }
